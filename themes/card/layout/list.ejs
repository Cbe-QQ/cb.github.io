<%
  var group = page.group;
  var posts = site.posts.filter(function (post) { return post.group === group; }).sort('order').toArray();
%>
<div class="collection">
  <h1 class="page-title"><%= page.title %></h1>
  <% if (page.description) { %><p class="page-desc"><%= page.description %></p><% } %>
  <% if (page.content && page.content.trim()) { %>
    <div class="article-content list-intro"><%- page.content %></div>
  <% } %>
  <%- partial('_partial/notes', { posts: posts }) %>
</div>
