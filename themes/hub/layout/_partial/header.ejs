<%
  var blog = site.data.blog || {};
  var isHomePage = page.layout === 'home';
  var navArticles = isHomePage || is_home() || is_post();
  var navCategories = is_category() || page.layout === 'categories';
  var navArchives = is_archive();
  var navAbout = page.layout === 'about';
%>
<header class="site-header<%= isHomePage ? '' : ' is-solid' %>" id="site-header">
  <a class="wordmark" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
    <span class="wordmark-mark" aria-hidden="true">✳</span>
    <span><%= blog.brand || 'CB' %><span class="wordmark-dot">.</span></span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    <a class="<%= navArticles ? 'nav-current' : '' %>" href="<%- url_for('/') %>#notes"<% if (navArticles) { %> aria-current="page"<% } %>>文章</a>
    <a class="<%= navCategories ? 'nav-current' : '' %>" href="<%- url_for('/categories/') %>"<% if (navCategories) { %> aria-current="page"<% } %>>分类</a>
    <a class="<%= navArchives ? 'nav-current' : '' %>" href="<%- url_for('/archives/') %>"<% if (navArchives) { %> aria-current="page"<% } %>>归档</a>
    <a class="<%= navAbout ? 'nav-current' : '' %>" href="<%- url_for('/about/') %>"<% if (navAbout) { %> aria-current="page"<% } %>>关于</a>
  </nav>
  <div class="header-tools">
    <a class="icon-button" href="<%- url_for('/search/') %>" aria-label="搜索文章" title="搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
    </a>
    <button id="theme-toggle" class="icon-button theme-button" type="button" aria-label="切换深色模式" aria-pressed="false" title="切换主题">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 14.2A8.6 8.6 0 0 1 9.8 3.6 8.6 8.6 0 1 0 20.4 14.2Z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="icon-button rss-link" href="<%- url_for('/rss.xml') %>" aria-label="RSS 订阅" title="RSS">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="5.5" cy="18.5" r="1.5" fill="currentColor" stroke="none"/></svg>
    </a>
  </div>
</header>
<% if (!isHomePage) { %>
<div class="site-header-space" aria-hidden="true"></div>
<% } %>
