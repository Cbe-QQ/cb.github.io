<div class="page-shell">
  <%- partial('_partial/page-head', {
    label: 'CATEGORY',
    heading: page.category,
    lede: '该分类下的全部笔记，按时间倒序排列。'
  }) %>
  <p class="back-link"><a href="<%- url_for('/categories/') %>">← 返回全部分类</a></p>
  <div class="article-list">
    <% page.posts.each(function (post) { %>
      <%- partial('_partial/post-card', { post: post }) %>
    <% }) %>
  </div>
  <% if (page.total > 1) { %>
  <nav class="paginator" aria-label="分页">
    <%- paginator({ prev_text: '←', next_text: '→' }) %>
  </nav>
  <% } %>
</div>
